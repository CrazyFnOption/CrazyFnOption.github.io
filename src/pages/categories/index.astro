---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, collectCategories } from '../../lib/posts';

const categories = collectCategories(await getPosts(false));

function tierOf(count: number): string {
  if (count >= 20) return 'tag-cloud--hot';
  if (count >= 8) return 'tag-cloud--warm';
  return 'tag-cloud--cool';
}
---

<BaseLayout title="分类">
  <div class="page-panel">
    <h1 class="page-title">
      分类 <span class="page-title__sub">{categories.length} 组</span>
    </h1>

    <p class="page-panel__lead">
      分类粒度比标签粗，用于把文章归入几个大方向。
    </p>

    <div class="tag-cloud">
      {
        categories.map(([name, count]) => (
          <a class={tierOf(count)} href={`/categories/${encodeURIComponent(name)}/`}>
            {name}
            <span class="tag-cloud__count">{count}</span>
          </a>
        ))
      }
    </div>

    <p class="page-panel__foot">
      想按更细的主题找文章，看<a href="/tags/">标签</a>页。
    </p>
  </div>
</BaseLayout>
