---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import { getPosts } from '../lib/posts';
import { POSTS_PER_PAGE } from '../site.config';

// 首页只列非归档文章
const posts = await getPosts();
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<BaseLayout showSidebarLinks={false}>
  <ul class="post-list">
    {pagePosts.map((post) => <PostListItem post={post} />)}
  </ul>

  {
    totalPages > 1 && (
      <nav class="pagination">
        <span class="is-current">1</span>
        {Array.from({ length: totalPages - 1 }, (_, i) => (
          <a href={`/page/${i + 2}/`}>{i + 2}</a>
        ))}
      </nav>
    )
  }
</BaseLayout>
