---
import { SITE } from '../site.config';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传入，用于 OG 卡片标注类型 */
  type?: 'website' | 'article';
  /** 文章页传入，用于 OG 卡片 */
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(SITE.ogImage, SITE.url).href;
const hasReadingSidebar = Astro.slots.has('sidebar');

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\.xml$/, ''));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    <!--
      主题预处理：**必须内联且放在最前**。
      若放到 body 末尾或用外链脚本，暗色模式下会先闪一下白屏（FOUC）。
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = saved === 'light' || saved === 'dark' ? saved : (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* localStorage 不可用时退回亮色，不阻塞渲染 */
        }
      })();
    </script>

    <!-- 社交卡片：分享到微信 / Twitter / 飞书时能出预览 -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL('/rss.xml', SITE.url).href}
    />

  </head>

  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
        <header class="site-header">
          <div class="site-header__inner">
          <a class="site-title" href="/">{SITE.title}<span>NOTES ON CODE &amp; LIFE</span></a>

          <nav class="site-nav" aria-label="主导航">
            {
              SITE.menu.map((item) => (
                <a
                  class:list={['site-nav__item', { 'is-active': isActive(item.href) }]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  <span>{item.label}</span>
                </a>
              ))
            }
          </nav>

          <div class="site-actions">
            <button
              class="icon-btn"
              id="search-open"
              type="button"
              aria-label="搜索"
              title="搜索（按 / 或 Ctrl+K）"
              aria-haspopup="dialog"
              aria-controls="search-dialog"
            >
              <Icon name="search" />
            </button>

            <button
              class="icon-btn"
              id="theme-toggle"
              type="button"
              aria-label="切换主题"
              title="切换亮色 / 暗色"
            >
              <Icon name="moon" class="theme-moon" /><Icon name="sun" class="theme-sun" />
            </button>
          </div>
          </div>
        </header>

    <div class:list={['page', { 'page--article': hasReadingSidebar }]}>
      <div class="page__main">
        <main class="site-content" id="main-content" tabindex="-1">
          <slot />
        </main>

        <footer class="site-footer">
          <p>
            &copy; {new Date().getFullYear()} {SITE.author} · Powered by
            <a href="https://astro.build">Astro</a> · 迁移自 Hexo / NexT
          </p>
          {/*
            Sitemap 从顶部导航移到了这里 —— 它面向爬虫，不该占给人看的导航位，
            但保留一个入口方便需要时查。
          */}
          <p class="site-footer__links">
            <a href="/rss.xml">RSS</a>
            <span class="site-footer__sep">·</span>
            <a href="/sitemap-index.xml">Sitemap</a>
            <span class="site-footer__sep">·</span>
            <a href="https://github.com/CrazyFnOption/CrazyFnOption.github.io">源码</a>
          </p>
        </footer>
      </div>

      <aside class="page__sidebar">
        <slot name="sidebar"><Sidebar /></slot>
      </aside>
    </div>

    <!-- 回到顶部 -->
    <button class="to-top" id="to-top" type="button" aria-label="回到顶部">
      <Icon name="arrow-up" />
    </button>

    <!-- 搜索弹层（内容由 Pagefind 在客户端注入） -->
    <div class="search-dialog" id="search-dialog" role="dialog" aria-modal="true" aria-labelledby="search-heading" aria-hidden="true" inert>
      <div class="search-dialog__panel">
      <div class="search-dialog__header">
      <h2 id="search-heading">搜索文章</h2>
      <button
        class="icon-btn search-dialog__close"
        id="search-close"
        type="button"
        aria-label="关闭搜索"
      >
        <Icon name="close" />
      </button>
      </div>
        <div id="search"></div>
      </div>
    </div>

    <script>
      // ---------------- 主题切换 ----------------
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme-toggle');
      function paintIcon() {
        const dark = root.dataset.theme === 'dark';
        themeBtn?.setAttribute('aria-label', dark ? '切换到亮色主题' : '切换到暗色主题');
        themeBtn?.setAttribute('title', dark ? '切换到亮色主题' : '切换到暗色主题');
      }
      paintIcon();

      themeBtn?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* 忽略：隐私模式下写不了 localStorage */
        }
        paintIcon();
      });

      // ---------------- 回到顶部 ----------------
      const toTop = document.getElementById('to-top');
      const onScroll = () => {
        toTop?.classList.toggle('is-visible', window.scrollY > 400);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      toTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      });

      // ---------------- 搜索 ----------------
      const dialog = document.getElementById('search-dialog')!;
      const searchClose = document.getElementById('search-close')!;
      const searchOpen = document.getElementById('search-open')!;
      const main = document.querySelector<HTMLElement>('.page')!;
      const header = document.querySelector<HTMLElement>('.site-header')!;
      const previousInert = new Map<HTMLElement, boolean>();
      let previousFocus: HTMLElement | null = null;
      let previousOverflow = '';
      let searchLoaded = false;
      let searchLoading: Promise<void> | null = null;

      /** 注入经典脚本并等待加载完成 */
      function loadScript(src: string) {
        return new Promise<void>((resolve, reject) => {
          const s = document.createElement('script');
          s.src = src;
          s.onload = () => resolve();
          s.onerror = () => reject(new Error(`加载失败: ${src}`));
          document.head.appendChild(s);
        });
      }

      /** 注入样式表（已存在则跳过） */
      function loadStyle(href: string) {
        return new Promise<void>((resolve) => {
          if (document.querySelector(`link[href="${href}"]`)) return resolve();
          const l = document.createElement('link');
          l.rel = 'stylesheet';
          l.href = href;
          l.onload = () => resolve();
          l.onerror = () => resolve(); // 样式失败不影响功能
          document.head.appendChild(l);
        });
      }

      async function openSearch() {
        if (dialog.classList.contains('is-open')) return;
        previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : searchOpen;
        previousOverflow = document.body.style.overflow;
        dialog.inert = false;
        dialog.setAttribute('aria-hidden', 'false');
        dialog.classList.add('is-open');
        [main, header, toTop].forEach((el) => { if (el) { previousInert.set(el, el.inert); el.inert = true; } });
        document.body.style.overflow = 'hidden';
        searchClose.focus();

        // Pagefind 只在第一次打开时加载，避免每个页面都拉一堆资源
        if (!searchLoaded && !searchLoading) {
          searchLoading = (async () => {
          try {
            // ⚠️ Pagefind 1.x 的 pagefind-ui.js 是 **IIFE**，末尾执行
            // `window.PagefindUI = ...`，**不是 ES 模块**（文件里一个 export 都没有）。
            // 用 import() 会拿到空对象。必须用 <script> 标签加载经典脚本。
            await loadScript('/pagefind/pagefind-ui.js');
            await loadStyle('/pagefind/pagefind-ui.css');

            const PF = (window as any).PagefindUI;
            if (!PF) throw new Error('PagefindUI 未挂载到 window');
            document.getElementById('search')?.replaceChildren();

            new PF({
              element: '#search',
              showSubResults: true,
              showImages: false,
              translations: {
                placeholder: '搜索文章…',
                zero_results: '没有找到「[SEARCH_TERM]」',
                many_results: '找到 [COUNT] 条结果',
                one_result: '找到 1 条结果',
                clear_search: '清空',
                load_more: '加载更多结果',
              },
            });
            searchLoaded = true;
          } catch (e) {
            // 本地 dev 或未建索引时 Pagefind 不存在，降级为提示
            const box = document.getElementById('search');
            if (box) {
              box.innerHTML =
                '<p class="search-message" role="status">搜索暂不可用，请稍后重试，或从归档页浏览文章。</p>';
            }
          }
          })();
        }
        await searchLoading;
        searchLoading = null;
        if (dialog.classList.contains('is-open')) document.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus();
      }

      function closeSearch() {
        if (!dialog.classList.contains('is-open')) return;
        dialog.classList.remove('is-open');
        dialog.setAttribute('aria-hidden', 'true');
        dialog.inert = true;
        previousInert.forEach((value, el) => { el.inert = value; });
        previousInert.clear();
        document.body.style.overflow = previousOverflow;
        previousFocus?.focus();
      }

      dialog.addEventListener('keydown', (event) => {
        if (event.key !== 'Tab') return;
        const focusable = Array.from(dialog.querySelectorAll<HTMLElement>('button, input, a[href], [tabindex="0"]')).filter(el => el.getClientRects().length && !el.matches(':disabled'));
        const first = focusable[0], last = focusable.at(-1);
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      });

      document.getElementById('search-open')?.addEventListener('click', openSearch);
      document.getElementById('search-close')?.addEventListener('click', closeSearch);

      // 点遮罩关闭
      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) closeSearch();
      });

      // 快捷键：/ 或 Ctrl/Cmd+K 打开，Esc 关闭
      document.addEventListener('keydown', (e) => {
        const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(
          (e.target as HTMLElement)?.tagName ?? '',
        ) || (e.target instanceof HTMLElement && e.target.isContentEditable);
        if (e.key === 'Escape') closeSearch();
        if (typing) return;
        if (e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) {
          e.preventDefault();
          openSearch();
        }
      });
    </script>
  </body>
</html>
