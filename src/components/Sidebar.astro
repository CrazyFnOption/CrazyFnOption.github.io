---
import { SITE } from '../site.config';
import { getPosts, collectCategories, collectTags } from '../lib/posts';

// 统计数字按旧站口径：**含归档文章**（旧站显示 108 posts / 6 categories / 67 tags）
const posts = await getPosts(true);
const stats = [
  { count: posts.length, label: 'posts' },
  { count: collectCategories(posts).length, label: 'categories' },
  { count: collectTags(posts).length, label: 'tags' },
];
---

<div class="sidebar">
  <div class="sidebar__author">
    <img class="sidebar__avatar" src={SITE.avatar} alt={SITE.author} width="110" height="110" />
    <p class="sidebar__name">{SITE.author}</p>
  </div>

  <div class="sidebar__stats">
    {
      stats.map((s) => (
        <div class="sidebar__stat">
          <span class="sidebar__stat-count">{s.count}</span>
          <span class="sidebar__stat-label">{s.label}</span>
        </div>
      ))
    }
  </div>

  <a class="sidebar__rss" href="/rss.xml">
    <span class="sidebar__rss-icon"></span> RSS
  </a>

  <div class="sidebar__social">
    {
      SITE.social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener">
          {s.label}
        </a>
      ))
    }
  </div>

  <div class="sidebar__links">
    <p class="sidebar__links-title">Links</p>
    {
      SITE.links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener">
          {l.label}
        </a>
      ))
    }
  </div>
</div>
