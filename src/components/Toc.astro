---
import type { TocItem } from '../lib/posts';

interface Props {
  items: TocItem[];
  /** inline 变体用于窄屏（收成正文顶部的可折叠块） */
  variant?: 'side' | 'inline';
}

const { items, variant = 'side' } = Astro.props;
---

{items.length > 2 && (variant === 'inline' ? (
  <details class="toc toc--inline">
    <summary>文章目录 <span>{items.length} 节</span></summary>
    <nav aria-label="文章目录"><ul>{items.map((h) => <li class={`toc__lvl-${h.depth}`}><a href={`#${h.slug}`} data-toc-link>{h.text}</a></li>)}</ul></nav>
  </details>
) : (
  <nav class="toc" aria-label="文章目录">
    <p class="toc__title">本页内容</p>
    <ul>{items.map((h) => <li class={`toc__lvl-${h.depth}`}><a href={`#${h.slug}`} data-toc-link>{h.text}</a></li>)}</ul>
  </nav>
))}
